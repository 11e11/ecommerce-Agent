# Committed baseline for the upstream watcher: without it a fresh clone has
# nothing to diff against and every source reads as new.
!maintenance/source-watch-state.json
!dist/knowledge/index.json
!dist/ontology.json
!dist/package-manifest.json
!dist/prompts.json
!ecommerce_ai_skills/package_data/dist/knowledge/index.json
